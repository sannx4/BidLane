FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -o /out/bidlane-engine \
    ./cmd/engine


FROM alpine:3.20

RUN adduser -D -u 10001 bidlane

COPY --from=builder /out/bidlane-engine /usr/local/bin/bidlane-engine

USER bidlane

ENTRYPOINT ["/usr/local/bin/bidlane-engine"]